# ============================================================
# Circuit OS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# Required — app fails at startup if missing
# Anthropic direct key: sk-ant-api03-...
# OpenRouter key:       sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# OpenRouter support (leave empty to use Anthropic direct)
# NOTE: Omit the /v1 suffix — the SDK adds it. Use https://openrouter.ai/api not /api/v1
ANTHROPIC_BASE_URL=
# Model ID — Anthropic direct: claude-sonnet-4-6
#             OpenRouter Anthropic: anthropic/claude-3-5-haiku-20241022
AI_MODEL=claude-sonnet-4-6

# PostgreSQL — matches docker-compose defaults for local dev
DATABASE_URL=postgresql+asyncpg://circuitos_user:circuitos_pass@localhost:5432/circuitos

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT signing key — minimum 32 random characters
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-32-plus-char-random-secret

# Optional — defaults shown
CELERY_BROKER_URL=redis://localhost:6379/1
ENVIRONMENT=development
SENTRY_DSN=
CORS_ORIGINS=http://localhost:3000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
