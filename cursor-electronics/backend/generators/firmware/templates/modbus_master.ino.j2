#include <SoftwareSerial.h>
#include <ModbusMaster.h>

// Arduino Uno RS-485: SoftwareSerial on pins 10 (RX) and 11 (TX)
#define RS485_RX_PIN     10
#define RS485_TX_PIN     11
#define RS485_DE_RE_PIN  {{ de_re_pin }}
#define MODBUS_BAUD      {{ baud_rate }}

SoftwareSerial rs485Serial(RS485_RX_PIN, RS485_TX_PIN);
ModbusMaster modbus;

void preTransmission()  { digitalWrite(RS485_DE_RE_PIN, HIGH); }
void postTransmission() { digitalWrite(RS485_DE_RE_PIN, LOW);  }

struct SlaveDevice {
  uint8_t  address;
  uint16_t reg_start;
  uint8_t  reg_count;
  const char* name;
};

SlaveDevice devices[] = {
{% for device in devices %}
  { {{ device.address }}, {{ device.register_start }}, {{ device.register_count }}, "{{ device.name }}" }{% if not loop.last %},{% endif %}

{% endfor %}
};

const int DEVICE_COUNT = {{ devices | length }};

void setup() {
  Serial.begin(115200);
  rs485Serial.begin(MODBUS_BAUD);

  pinMode(RS485_DE_RE_PIN, OUTPUT);
  digitalWrite(RS485_DE_RE_PIN, LOW);  // Start in receive mode

  modbus.begin(devices[0].address, rs485Serial);
  modbus.preTransmission(preTransmission);
  modbus.postTransmission(postTransmission);

  Serial.println("[CircuitOS] Modbus RTU Master started.");
  Serial.print("[CircuitOS] Polling ");
  Serial.print(DEVICE_COUNT);
  Serial.println(" device(s).");
}

void loop() {
  for (int i = 0; i < DEVICE_COUNT; i++) {
    modbus.begin(devices[i].address, rs485Serial);

    uint8_t result = modbus.readHoldingRegisters(
      devices[i].reg_start,
      devices[i].reg_count
    );

    Serial.print("[Modbus] ");
    Serial.print(devices[i].name);
    Serial.print(" (addr=");
    Serial.print(devices[i].address);
    Serial.print(") -> ");

    if (result == modbus.ku8MBSuccess) {
      for (int r = 0; r < devices[i].reg_count; r++) {
        Serial.print("Reg[");
        Serial.print(devices[i].reg_start + r);
        Serial.print("]=");
        Serial.print(modbus.getResponseBuffer(r));
        if (r < devices[i].reg_count - 1) Serial.print(", ");
      }
      Serial.println();
    } else {
      Serial.print("ERROR 0x");
      Serial.println(result, HEX);
    }

    delay(100);  // Inter-device delay
  }

  delay({{ poll_interval_ms }});
}
