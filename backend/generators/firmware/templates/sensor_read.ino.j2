/*
 * Generated by Circuit OS
 * Template: sensor_read (DHT22/DHT11)
 * Intent: {{ ir.intent }}
 * Circuit ID: {{ ir.circuit_id }}
 * Version: {{ ir.version }}
 * Simulation validated: {{ ir.simulation_passed if ir.simulation_passed is not none else "pending" }}
 */

#include <DHT.h>

#define DHTPIN    {{ dht_pin }}
#define DHTTYPE   {{ dht_type }}
{% if threshold_temp is not none %}
#define THRESHOLD_TEMP {{ threshold_temp }}
{% endif %}
{% if alert_pin is not none %}
#define ALERT_PIN {{ alert_pin }}
{% endif %}

DHT dht(DHTPIN, DHTTYPE);

void setup() {
  Serial.begin(115200);
  dht.begin();
{% if alert_pin is not none %}
  pinMode(ALERT_PIN, OUTPUT);
  digitalWrite(ALERT_PIN, LOW);
{% endif %}
  Serial.println("[CircuitOS] {{ ir.intent }}");
  Serial.println("[CircuitOS] Setup complete.");
}

void loop() {
  float humidity    = dht.readHumidity();
  float temperature = dht.readTemperature();

  if (isnan(humidity) || isnan(temperature)) {
    Serial.println("[ERROR] Sensor read failed. Check wiring and 10k pull-up on DATA pin.");
    delay(2000);
    return;
  }

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.print(" C   Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

{% if threshold_temp is not none %}
  if (temperature > THRESHOLD_TEMP) {
    Serial.print("[ALERT] Temperature ");
    Serial.print(temperature);
    Serial.print(" C exceeds threshold ");
    Serial.print(THRESHOLD_TEMP);
    Serial.println(" C");
{% if alert_pin is not none %}
    digitalWrite(ALERT_PIN, HIGH);
{% endif %}
  } else {
{% if alert_pin is not none %}
    digitalWrite(ALERT_PIN, LOW);
{% endif %}
  }
{% endif %}

  // DHT22 minimum sample interval is 2 seconds
  delay(2000);
}
