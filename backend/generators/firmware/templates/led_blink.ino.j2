/*
 * Generated by Circuit OS
 * Template: led_blink
 * Intent: {{ ir.intent }}
 * Circuit ID: {{ ir.circuit_id }}
 */

#define LED_PIN  {{ led_pin }}

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  Serial.println("[CircuitOS] {{ ir.intent }}");
}

void loop() {
  digitalWrite(LED_PIN, HIGH);
  Serial.println("[LED] ON");
  delay({{ on_time_ms | default(1000) }});

  digitalWrite(LED_PIN, LOW);
  Serial.println("[LED] OFF");
  delay({{ off_time_ms | default(1000) }});
}
