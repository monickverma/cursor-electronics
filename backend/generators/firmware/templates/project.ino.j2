/*
 * Generated by Circuit OS — Template: project (Composition M2)
 * Intent: {{ intent }}
 * Board: {{ board }}
 * Circuit ID: {{ circuit_id }}
 *
 * Blocks:
{% for line in block_lines %}
 *   {{ line }}
{% endfor %}
 *
 * Behaviour, evaluated in order after every sensor reading (later rules win):
{% for rule in rules %}
 *   {{ loop.index }}. {{ rule.text }}
{% endfor %}
{% if not rules %}
 *   (none — every output stays off)
{% endif %}
 */

{% if sensors %}
#include <DHT.h>
{% endif %}

enum Mode { MODE_OFF, MODE_ON, MODE_BLINK, MODE_HEARTBEAT };

{% for s in sensors %}
// {{ s.id }}: DHT22 on {{ s.pin_name }}
DHT {{ s.var }}({{ s.pin }}, DHT22);
float {{ s.id }}_temperature_c = NAN;
float {{ s.id }}_humidity_pct = NAN;
bool {{ s.id }}_ok = false;
{% endfor %}

{% if outputs %}
// Outputs: {% for o in outputs %}{{ o.id }} on {{ o.pin_name }}{% if not loop.last %}, {% endif %}{% endfor %}

const int OUT_PINS[{{ outputs|length }}] = { {% for o in outputs %}{{ o.pin }}{% if not loop.last %}, {% endif %}{% endfor %} };
const char* const OUT_NAMES[{{ outputs|length }}] = { {% for o in outputs %}"{{ o.id }}"{% if not loop.last %}, {% endif %}{% endfor %} };
Mode out_mode[{{ outputs|length }}];
{% endif %}

const unsigned long READ_INTERVAL_MS = 2000;   // the DHT22 cannot be read faster
unsigned long last_read = 0;
bool first_read = true;

const char* mode_name(Mode m) {
  switch (m) {
    case MODE_ON: return "on";
    case MODE_BLINK: return "blink";
    case MODE_HEARTBEAT: return "heartbeat";
    default: return "off";
  }
}

void evaluate_rules() {
{% if outputs %}
  Mode next[{{ outputs|length }}];
  for (int i = 0; i < {{ outputs|length }}; i++) next[i] = MODE_OFF;
{% for rule in rules %}
  // {{ loop.index }}. {{ rule.text }}
{% if rule.kind == "always" %}
  next[{{ rule.then_out }}] = {{ rule.then_mode }};
{% else %}
  if ({{ rule.guard }} && ({{ rule.expr }})) {
    next[{{ rule.then_out }}] = {{ rule.then_mode }};
  }{% if rule.else_out is not none %} else {
    next[{{ rule.else_out }}] = {{ rule.else_mode }};
  }{% endif %}

{% endif %}
{% endfor %}
  for (int i = 0; i < {{ outputs|length }}; i++) {
    if (next[i] != out_mode[i]) {
      Serial.print("[OUT] ");
      Serial.print(OUT_NAMES[i]);
      Serial.print(" -> ");
      Serial.println(mode_name(next[i]));
    }
    out_mode[i] = next[i];
  }
{% endif %}
}

void read_sensors() {
{% for s in sensors %}
  {{ s.id }}_humidity_pct = {{ s.var }}.readHumidity();
  {{ s.id }}_temperature_c = {{ s.var }}.readTemperature();
  {{ s.id }}_ok = !(isnan({{ s.id }}_humidity_pct) || isnan({{ s.id }}_temperature_c));
  if ({{ s.id }}_ok) {
    Serial.print("[{{ s.id }}] ");
    Serial.print({{ s.id }}_temperature_c);
    Serial.print(" C  ");
    Serial.print({{ s.id }}_humidity_pct);
    Serial.println(" %");
  } else {
    Serial.println("[{{ s.id }}] read failed: check wiring and the pull-up on {{ s.pin_name }}");
  }
{% endfor %}
}

void setup() {
  Serial.begin(115200);
{% for s in sensors %}
  {{ s.var }}.begin();
{% endfor %}
{% if outputs %}
  for (int i = 0; i < {{ outputs|length }}; i++) {
    pinMode(OUT_PINS[i], OUTPUT);
    digitalWrite(OUT_PINS[i], LOW);
    out_mode[i] = MODE_OFF;
  }
{% endif %}
  Serial.println("[CircuitOS] {{ intent }}");
}

void loop() {
  unsigned long now = millis();
  if (first_read || now - last_read >= READ_INTERVAL_MS) {
    first_read = false;
    last_read = now;
    read_sensors();
    evaluate_rules();
  }
{% if outputs %}
  for (int i = 0; i < {{ outputs|length }}; i++) {
    bool level = false;
    switch (out_mode[i]) {
      case MODE_ON: level = true; break;
      case MODE_BLINK: level = (now / 250) % 2 == 0; break;
      case MODE_HEARTBEAT: level = (now % 1000) < 100; break;
      default: level = false;
    }
    digitalWrite(OUT_PINS[i], level ? HIGH : LOW);
  }
{% endif %}
}
