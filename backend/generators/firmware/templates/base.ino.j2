/*
 * Generated by Circuit OS
 * Intent: {{ ir.intent }}
 * Circuit ID: {{ ir.circuit_id }}
 * Version: {{ ir.version }}
 * Target MCU: {{ ir.target_mcu or "unspecified" }}
 * Simulation validated: {{ ir.simulation_passed if ir.simulation_passed is not none else "pending" }}
 *
 * Review before flashing. This file was generated from a validated IR schema.
 */

{% for inc in includes %}
#include <{{ inc }}>
{% endfor %}

/* Pin definitions */
{% for pin_name, pin_num in pin_definitions.items() %}
#define PIN_{{ pin_name }}  {{ pin_num }}
{% endfor %}

/* Constants */
{% for const in constants %}
const {{ const.type }} {{ const.name }} = {{ const.value }};
{% endfor %}

void setup() {
  Serial.begin(115200);
  Serial.println("[CircuitOS] {{ ir.intent }}");
{% for line in setup_lines %}
  {{ line }}
{% endfor %}
  Serial.println("[CircuitOS] Setup complete.");
}

void loop() {
{% for line in loop_lines %}
  {{ line }}
{% endfor %}
  delay({{ loop_delay_ms | default(1000) }});
}
