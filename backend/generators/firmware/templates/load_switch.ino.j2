/*
 * Generated by Circuit OS
 * Template: load_switch
 * Intent: {{ ir.intent }}
 * Circuit ID: {{ ir.circuit_id }}
 *
 * Send '1' on the serial monitor to switch the load on, '0' to switch it off.
 */

#define SWITCH_PIN  {{ switch_pin }}

void setup() {
  Serial.begin(115200);
  pinMode(SWITCH_PIN, OUTPUT);
  digitalWrite(SWITCH_PIN, LOW);   // load off from boot
  Serial.println("[CircuitOS] {{ ir.intent }}");
  Serial.println("[CircuitOS] Send 1 for on, 0 for off.");
}

void loop() {
  if (Serial.available() > 0) {
    char c = Serial.read();
    if (c == '1') {
      digitalWrite(SWITCH_PIN, HIGH);
      Serial.println("[LOAD] ON");
    } else if (c == '0') {
      digitalWrite(SWITCH_PIN, LOW);
      Serial.println("[LOAD] OFF");
    }
  }
}
